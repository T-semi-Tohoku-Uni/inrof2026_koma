<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="free_ball">
    <Sequence>
      <arm_pursuit_pose/>
      <arm_ee_open/>
      <Sleep msec="2000"/>
      <arm_ee_close/>
      <Sleep msec="2000"/>
      <goal_position x="0.15"
                     y="0.75"
                     theta="1.57"/>
      <pursuit/>
      <arm_default_pose/>
      <arm_root_pose theta="-1.57"/>
      <Sleep msec="1000"/>
      <arm_ee_open/>
      <Sleep msec="1000"/>
      <arm_pursuit_pose/>
      <waypoint x="0.3"
                y="2.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="main">
    <Sequence>
      <SubTree ID="free_ball"
               _autoremap="false"/>
      <KeepRunningUntilFailure>
        <Sequence>
          <goal_position x="1.34"
                         y="2.00"
                         theta="-1.57"/>
          <pursuit/>
          <arm_ee_open/>
          <WhileDoElseBreak>
            <target_ball_position x="{x}"
                                  y="{y}"
                                  z="{z}"/>
            <Sequence>
              <path_ball x="{x}"
                         y="{y}"/>
              <pursuit/>
              <arm_default_pose/>
              <Sleep msec="1000"/>
              <arm_control x="{x}"
                           y="{y}"
                           z="{z}"/>
              <arm_ee_close/>
              <Sleep msec="1500"/>
              <arm_default_pose/>
              <Sleep msec="1000"/>
              <arm_pursuit_pose/>
              <waypoint x="1.34"
                        y="2.00"/>
              <pursuit/>
              <waypoint x="0.3"
                        y="2.0"/>
              <goal_position x="0.15"
                             y="0.75"
                             theta="-1.57"/>
              <pursuit/>
              <arm_default_pose/>
              <arm_root_pose theta="1.57"/>
              <Sleep msec="1000"/>
              <arm_ee_open/>
              <Sleep msec="1000"/>
              <arm_pursuit_pose/>
              <waypoint x="0.3"
                        y="2.0"/>
            </Sequence>
            <Sequence>
              <goal_position x="0.25"
                             y="0.25"
                             theta="-1.57"/>
              <pursuit/>
            </Sequence>
          </WhileDoElseBreak>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Control ID="WhileDoElseBreak"
             editable="true"/>
    <Action ID="arm_control"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="z"/>
    </Action>
    <Action ID="arm_default_pose"
            editable="true"/>
    <Action ID="arm_ee_close"
            editable="true"/>
    <Action ID="arm_ee_open"
            editable="true"/>
    <Action ID="arm_pursuit_pose"
            editable="true"/>
    <Action ID="arm_root_pose"
            editable="true">
      <input_port name="theta"/>
    </Action>
    <Action ID="goal_position"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="theta"/>
    </Action>
    <Action ID="path_ball"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
    <Action ID="pursuit"
            editable="true"/>
    <Action ID="target_ball_position"
            editable="true">
      <output_port name="x"/>
      <output_port name="y"/>
      <output_port name="z"/>
    </Action>
    <Action ID="waypoint"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
  </TreeNodesModel>

</root>
