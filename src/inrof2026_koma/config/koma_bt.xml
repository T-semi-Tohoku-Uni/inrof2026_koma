<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="free_ball">
    <Sequence>
      <Sleep msec="5"/>
      <waypoint x="0.3"
                y="2.0"/>
      <goal_position x="1.34"
                     y="2.0"
                     theta="-1.57"/>
      <pursuit/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="main">
    <Sequence>
      <SubTree ID="free_ball"
               _autoremap="false"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="goal_position"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="theta"/>
    </Action>
    <Action ID="pursuit"
            editable="true"/>
    <Action ID="waypoint"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
  </TreeNodesModel>

</root>
